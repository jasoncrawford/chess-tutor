{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/index.py": { "maxDuration": 90 } },
  "env": {
    "CHESS_TUTOR_COACHING_MODEL_CONFIG": "CoachingServer/configs/production-v2.json"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
